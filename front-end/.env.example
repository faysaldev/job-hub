# Backend API & Socket Base URL (e.g., http://localhost:3001 or deployed backend domain)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Backend API URL for server-side fetches (e.g., in metadata generation)
NEXT_PUBLIC_API_URL=http://localhost:3001


# Public Cloudflare R2 custom domain (images only, never the private bucket).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://media.example.com
