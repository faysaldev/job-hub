# Backend Server Configuration
BACKEND_IP=0.0.0.0
PORT=3001

# Socket.IO Port
SOCKET_PORT=9900

# Database Connection (MongoDB URI)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/job-hubs?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
# Phase 1: fixed 15-minute access token + 30-day rotating refresh cookie.
# Generate independent 32+ byte random strings; never commit them to Git.
# Example: openssl rand -hex 32
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Email Configuration (Nodemailer / SMTP)
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_app_password

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Fixed price (USD cents) for optional legacy candidate boost. Leave 0 to disable.
APPLICATION_BOOST_PRICE_CENTS=0

# Redis Connection (Use 'localhost' for local development or 'redis' for Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloudflare R2: TWO distinct buckets; private bucket must never be publicly exposed.
# Use an R2 S3 API token with object read/write limited to these buckets.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=jobhub-public
R2_PRIVATE_BUCKET=jobhub-private
# A verified HTTPS custom domain for the PUBLIC bucket only; no trailing slash.
R2_PUBLIC_BASE_URL=https://media.example.com
# Enable only when multiple Socket.IO server instances share the same Redis.
SOCKET_REDIS_ADAPTER=false
# Optional rediss:// managed Redis URL; overrides REDIS_HOST/PORT/PASSWORD.
REDIS_URL=
# Migration and indexes require explicit operator approval.
PHASE3_MIGRATION_APPROVED=no
PHASE3_ROLLBACK_APPROVED=no
PHASE3_INDEXES_APPROVED=no

# Crypto Secret Key
CRYPTO_SECRET_KEY=your_crypto_secret_key_here

# Frontend origins (exact, comma-separated). Used by HTTP, Socket.IO, and emails.
FRONTEND_URL=http://localhost:3000
# For different-site production deployments use AUTH_COOKIE_SAME_SITE=none with HTTPS.
# For local/same-site dev, use lax.
AUTH_COOKIE_SAME_SITE=lax
# Set only behind a trusted reverse proxy that forwards the true client IP.
TRUST_PROXY=false

