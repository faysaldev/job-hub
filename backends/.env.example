# Backend Server Configuration
BACKEND_IP=0.0.0.0
PORT=3001

# Socket.IO Port
SOCKET_PORT=9900

# Database Connection (MongoDB URI)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/job-hubs?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
# 30 days in milliseconds = 30 * 86400000 = 2592000000
JWT_EXPIRE_TIME=2592000000
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Email Configuration (Nodemailer / SMTP)
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_app_password

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Redis Connection (Use 'localhost' for local development or 'redis' for Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Crypto Secret Key
CRYPTO_SECRET_KEY=your_crypto_secret_key_here

# Frontend Application URL (CORS & Verification / Reset Password Redirects)
FRONTEND_URL=http://localhost:3000

